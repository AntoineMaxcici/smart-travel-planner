<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TravelPlanner.Core.ViewModels;assembly=TravelPlanner.Core"
             x:Class="TravelPlanner.Maui.MainPage" x:DataType="vm:HomeViewModel" Title="Home">
    <ScrollView>
        <VerticalStackLayout Padding="28" Spacing="20" MaximumWidthRequest="640">
            <Label Text="{Binding WelcomeMessage}" FontSize="28" FontAttributes="Bold"
                   SemanticProperties.HeadingLevel="Level1" AutomationId="WelcomeMessage" />
            <Label Text="{Binding Email}" />
            <Label Text="You’re signed in and ready to plan your next trip." FontSize="16" />
            <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="{AppThemeBinding Light=#B42318, Dark=#FFB4AB}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Button Text="Sign out" Command="{Binding SignOutCommand}" AutomationId="SignOutButton" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
