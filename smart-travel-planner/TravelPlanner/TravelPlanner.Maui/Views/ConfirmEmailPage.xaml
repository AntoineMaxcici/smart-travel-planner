<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TravelPlanner.Core.ViewModels;assembly=TravelPlanner.Core"
             x:Class="TravelPlanner.Maui.Views.ConfirmEmailPage"
             x:DataType="vm:ConfirmEmailViewModel" Title="Confirm your email">
    <ScrollView>
        <VerticalStackLayout Padding="28" Spacing="18" MaximumWidthRequest="440"
                             VerticalOptions="Center" HorizontalOptions="Fill">
            <Label Text="Check your email" FontSize="32" FontAttributes="Bold" SemanticProperties.HeadingLevel="Level1" />
            <Label Text="{Binding Instructions}" FontSize="16" />
            <Label Text="Confirmation code" />
            <Entry Text="{Binding Code}" Placeholder="123456" Keyboard="Numeric"
                   IsEnabled="{Binding IsNotBusy}" ReturnType="Go" MaxLength="12"
                   FontSize="24" CharacterSpacing="6"
                   ReturnCommand="{Binding ConfirmCommand}" AutomationId="ConfirmCode"
                   SemanticProperties.Description="Six digit confirmation code" />
            <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}"
                   TextColor="{AppThemeBinding Light=#B42318, Dark=#FFB4AB}" AutomationId="ConfirmError" />
            <Label Text="{Binding InfoMessage}" IsVisible="{Binding HasInfo}" AutomationId="ConfirmInfo" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               SemanticProperties.Description="Please wait" />
            <Button Text="Confirm and sign in" Command="{Binding ConfirmCommand}" AutomationId="ConfirmButton" />
            <Button Text="Didn't get it? Send a new code" Command="{Binding ResendCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                    AutomationId="ResendCodeButton" />
            <Button Text="Back to sign in" Command="{Binding GoToLoginCommand}"
                    IsEnabled="{Binding IsNotBusy}" BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                    AutomationId="ConfirmBackToLoginButton" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
