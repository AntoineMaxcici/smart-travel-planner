    "Register": { "PermitLimit": 5, "WindowSeconds": 900 },
    "EmailConfirmation": { "PermitLimit": 10, "WindowSeconds": 900 }
  },
  "Email": {
    "Smtp": {
      "Host": "",
      "Port": 587,
      "EnableSsl": true,
      "FromName": "TravelPlanner"
    }
  },
  "Gemini": { "ApiKey": "" },
  "GooglePlaces": { "ApiKey": "" }
}
