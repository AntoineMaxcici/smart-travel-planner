    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>e9e465ad-f9c6-4a1e-aea3-2d92428f6d04</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.21" />
