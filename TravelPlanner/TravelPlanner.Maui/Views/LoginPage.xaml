<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TravelPlanner.Core.ViewModels;assembly=TravelPlanner.Core"
             x:Class="TravelPlanner.Maui.Views.LoginPage"
             x:DataType="vm:LoginViewModel" Title="Sign in">
    <ScrollView>
        <VerticalStackLayout Padding="28" Spacing="18" MaximumWidthRequest="440"
                             VerticalOptions="Center" HorizontalOptions="Fill">
            <Label Text="TravelPlanner" FontSize="32" FontAttributes="Bold" SemanticProperties.HeadingLevel="Level1" />
            <Label Text="Sign in to plan your next trip." FontSize="16" />
            <Label Text="Email" />
            <Entry Text="{Binding Email}" Placeholder="you@example.com" Keyboard="Email"
                   IsEnabled="{Binding IsNotBusy}" ReturnType="Next" MaxLength="254"
                   AutomationId="LoginEmail" SemanticProperties.Description="Email address" />
            <Label Text="Password" />
            <Entry Text="{Binding Password}" Placeholder="Password" IsPassword="True"
                   IsEnabled="{Binding IsNotBusy}" ReturnType="Go" MaxLength="1024"
                   ReturnCommand="{Binding LoginCommand}" AutomationId="LoginPassword"
                   SemanticProperties.Description="Password" />
            <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}"
                   TextColor="{AppThemeBinding Light=#B42318, Dark=#FFB4AB}" AutomationId="LoginError" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               SemanticProperties.Description="Signing in" />
            <Button Text="Sign in" Command="{Binding LoginCommand}" AutomationId="LoginButton" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
