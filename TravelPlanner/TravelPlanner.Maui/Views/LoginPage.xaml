<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TravelPlanner.Core.ViewModels;assembly=TravelPlanner.Core"
             xmlns:controls="clr-namespace:TravelPlanner.Maui.Controls"
             x:Class="TravelPlanner.Maui.Views.LoginPage"
             x:DataType="vm:LoginViewModel" Title="Sign in"
             BackgroundColor="{StaticResource TourvexNavy}">
    <!-- The template's home hero (see Controls/AuthLayout.cs) with the sign-in form in place of its button. -->
    <controls:AuthLayout Eyebrow="TravelPlanner"
                         Title="Discover the world"
                         Accent="with your own planner."
                         Subtitle="Turn your dream destinations into real plans. Sign in to see your trips, dates and budgets in one place.">
        <VerticalStackLayout Spacing="16">
            <Label Style="{StaticResource TvFormTitle}">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Welcome " />
                        <Span Text="back" Style="{StaticResource TvFormAccent}" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>
            <controls:PillField Icon="{x:Static controls:TvIcons.Email}">
                <Entry Text="{Binding Email}" Placeholder="Your email" Keyboard="Email"
                       Style="{StaticResource TvFieldInput}"
                       IsEnabled="{Binding IsNotBusy}" ReturnType="Next" MaxLength="254"
                       AutomationId="LoginEmail" SemanticProperties.Description="Email address" />
            </controls:PillField>
            <controls:PillField Icon="{x:Static controls:TvIcons.Lock}">
                <Entry Text="{Binding Password}" Placeholder="Your password" IsPassword="True"
                       Style="{StaticResource TvFieldInput}"
                       IsEnabled="{Binding IsNotBusy}" ReturnType="Go" MaxLength="1024"
                       ReturnCommand="{Binding LoginCommand}" AutomationId="LoginPassword"
                       SemanticProperties.Description="Password" />
            </controls:PillField>
            <Button Text="Forgot password?" Command="{Binding GoToForgotPasswordCommand}"
                    Style="{StaticResource TvLinkButton}" HorizontalOptions="End" Margin="0,-6,0,0"
                    IsEnabled="{Binding IsNotBusy}" AutomationId="ForgotPasswordButton"
                    SemanticProperties.Hint="Get a code by email to choose a new password" />
            <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}"
                   Style="{StaticResource TvError}" AutomationId="LoginError" />
            <controls:ArrowButton Text="Sign in" Command="{Binding LoginCommand}" IsBusy="{Binding IsBusy}"
                                  AutomationId="LoginButton" />
        </VerticalStackLayout>

        <controls:AuthLayout.Footer>
            <VerticalStackLayout Spacing="12">
                <Label Text="New to TravelPlanner?" Style="{StaticResource TvHeroNote}" />
                <controls:ArrowButton Text="Create account" Variant="White"
                                      Command="{Binding GoToRegisterCommand}" AutomationId="GoToRegisterButton" />
            </VerticalStackLayout>
        </controls:AuthLayout.Footer>
    </controls:AuthLayout>
</ContentPage>
