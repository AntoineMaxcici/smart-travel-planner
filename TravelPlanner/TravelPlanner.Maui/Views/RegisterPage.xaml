<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TravelPlanner.Core.ViewModels;assembly=TravelPlanner.Core"
             xmlns:controls="clr-namespace:TravelPlanner.Maui.Controls"
             x:Class="TravelPlanner.Maui.Views.RegisterPage"
             x:DataType="vm:RegisterViewModel" Title="Create account"
             BackgroundColor="{StaticResource TourvexNavy}">
    <controls:AuthLayout Eyebrow="Join TravelPlanner"
                         Title="Start your journey"
                         Accent="with us."
                         Subtitle="Create a free account to plan trips around the places, dates and budget that suit you.">
        <VerticalStackLayout Spacing="16">
            <Label Style="{StaticResource TvFormTitle}">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Create your " />
                        <Span Text="account" Style="{StaticResource TvFormAccent}" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>
            <controls:PillField Icon="{x:Static controls:TvIcons.Person}">
                <Entry Text="{Binding DisplayName}" Placeholder="Your name (optional)" Keyboard="Text"
                       Style="{StaticResource TvFieldInput}"
                       IsEnabled="{Binding IsNotBusy}" ReturnType="Next" MaxLength="100"
                       AutomationId="RegisterDisplayName" SemanticProperties.Description="Display name" />
            </controls:PillField>
            <controls:PillField Icon="{x:Static controls:TvIcons.Email}">
                <Entry Text="{Binding Email}" Placeholder="Your email" Keyboard="Email"
                       Style="{StaticResource TvFieldInput}"
                       IsEnabled="{Binding IsNotBusy}" ReturnType="Next" MaxLength="254"
                       AutomationId="RegisterEmail" SemanticProperties.Description="Email address" />
            </controls:PillField>
            <controls:PillField Icon="{x:Static controls:TvIcons.Lock}">
                <Entry Text="{Binding Password}" Placeholder="Password" IsPassword="True"
                       Style="{StaticResource TvFieldInput}"
                       IsEnabled="{Binding IsNotBusy}" ReturnType="Next" MaxLength="1024"
                       AutomationId="RegisterPassword" SemanticProperties.Description="Password" />
            </controls:PillField>
            <Label Text="{Binding PasswordRequirements}" Style="{StaticResource TvHint}" />
            <controls:PillField Icon="{x:Static controls:TvIcons.Lock}">
                <Entry Text="{Binding ConfirmPassword}" Placeholder="Repeat password" IsPassword="True"
                       Style="{StaticResource TvFieldInput}"
                       IsEnabled="{Binding IsNotBusy}" ReturnType="Go" MaxLength="1024"
                       ReturnCommand="{Binding RegisterCommand}" AutomationId="RegisterConfirmPassword"
                       SemanticProperties.Description="Confirm password" />
            </controls:PillField>
            <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}"
                   Style="{StaticResource TvError}" AutomationId="RegisterError" />
            <controls:ArrowButton Text="Create account" Command="{Binding RegisterCommand}" IsBusy="{Binding IsBusy}"
                                  AutomationId="RegisterButton" />
        </VerticalStackLayout>

        <controls:AuthLayout.Footer>
            <VerticalStackLayout Spacing="12">
                <Label Text="Already have an account?" Style="{StaticResource TvHeroNote}" />
                <controls:ArrowButton Text="Sign in" Variant="White"
                                      Command="{Binding GoToLoginCommand}" AutomationId="GoToLoginButton" />
            </VerticalStackLayout>
        </controls:AuthLayout.Footer>
    </controls:AuthLayout>
</ContentPage>
