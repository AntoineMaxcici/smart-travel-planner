<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TravelPlanner.Core.ViewModels;assembly=TravelPlanner.Core"
             xmlns:controls="clr-namespace:TravelPlanner.Maui.Controls"
             x:Class="TravelPlanner.Maui.Views.ForgotPasswordPage"
             x:DataType="vm:ForgotPasswordViewModel" Title="Reset password"
             BackgroundColor="{StaticResource TourvexNavy}">
    <controls:AuthLayout Eyebrow="Account help"
                         Title="Lost your way?"
                         Accent="we'll get you back."
                         Subtitle="Forgot your password? We'll email you a 6-digit code so you can choose a new one and carry on planning.">
        <VerticalStackLayout Spacing="16">
            <Label Style="{StaticResource TvFormTitle}">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Reset your " />
                        <Span Text="password" Style="{StaticResource TvFormAccent}" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>
            <Label Text="{Binding Instructions}" Style="{StaticResource TvFormText}" AutomationId="ForgotInstructions" />

            <!-- Step 1: email -->
            <VerticalStackLayout Spacing="16" IsVisible="{Binding IsEmailStep}">
                <controls:PillField Icon="{x:Static controls:TvIcons.Email}">
                    <Entry Text="{Binding Email}" Placeholder="Your email" Keyboard="Email"
                           Style="{StaticResource TvFieldInput}"
                           IsEnabled="{Binding IsNotBusy}" ReturnType="Go" MaxLength="254"
                           ReturnCommand="{Binding SendCodeCommand}" AutomationId="ForgotEmail"
                           SemanticProperties.Description="Email address" />
                </controls:PillField>
            </VerticalStackLayout>

            <!-- Step 2: code and new password -->
            <VerticalStackLayout Spacing="16" IsVisible="{Binding IsCodeStep}">
                <controls:PillField Icon="{x:Static controls:TvIcons.Code}">
                    <Entry Text="{Binding Code}" Placeholder="123456" Keyboard="Numeric"
                           Style="{StaticResource TvFieldInput}" FontSize="22" CharacterSpacing="6"
                           IsEnabled="{Binding IsNotBusy}" ReturnType="Next" MaxLength="12"
                           AutomationId="ResetCode" SemanticProperties.Description="Six digit reset code" />
                </controls:PillField>
                <controls:PillField Icon="{x:Static controls:TvIcons.Lock}">
                    <Entry Text="{Binding NewPassword}" Placeholder="New password" IsPassword="True"
                           Style="{StaticResource TvFieldInput}"
                           IsEnabled="{Binding IsNotBusy}" ReturnType="Next" MaxLength="1024"
                           AutomationId="ResetNewPassword" SemanticProperties.Description="New password" />
                </controls:PillField>
                <Label Text="{Binding PasswordRequirements}" Style="{StaticResource TvHint}" />
                <controls:PillField Icon="{x:Static controls:TvIcons.Lock}">
                    <Entry Text="{Binding ConfirmPassword}" Placeholder="Repeat new password" IsPassword="True"
                           Style="{StaticResource TvFieldInput}"
                           IsEnabled="{Binding IsNotBusy}" ReturnType="Go" MaxLength="1024"
                           ReturnCommand="{Binding ResetCommand}" AutomationId="ResetConfirmPassword"
                           SemanticProperties.Description="Confirm new password" />
                </controls:PillField>
            </VerticalStackLayout>

            <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}"
                   Style="{StaticResource TvError}" AutomationId="ForgotError" />
            <Label Text="{Binding InfoMessage}" IsVisible="{Binding HasInfo}"
                   Style="{StaticResource TvInfo}" AutomationId="ForgotInfo" />

            <controls:ArrowButton Text="Send code" Command="{Binding SendCodeCommand}" IsBusy="{Binding IsBusy}"
                                  IsVisible="{Binding IsEmailStep}" AutomationId="SendResetCodeButton" />
            <controls:ArrowButton Text="Reset password" Command="{Binding ResetCommand}" IsBusy="{Binding IsBusy}"
                                  IsVisible="{Binding IsCodeStep}" AutomationId="ResetPasswordButton" />
            <HorizontalStackLayout Spacing="8" IsVisible="{Binding IsCodeStep}">
                <Button Text="Send a new code" Command="{Binding ResendCommand}"
                        Style="{StaticResource TvLinkButton}" AutomationId="ResendResetCodeButton" />
                <Button Text="Use another email" Command="{Binding ChangeEmailCommand}"
                        Style="{StaticResource TvLinkButton}" IsEnabled="{Binding IsNotBusy}"
                        AutomationId="ChangeResetEmailButton" />
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <controls:AuthLayout.Footer>
            <VerticalStackLayout Spacing="12">
                <Label Text="Remembered it?" Style="{StaticResource TvHeroNote}" />
                <controls:ArrowButton Text="Back to sign in" Variant="White"
                                      Command="{Binding GoToLoginCommand}" AutomationId="ForgotBackToLoginButton" />
            </VerticalStackLayout>
        </controls:AuthLayout.Footer>
    </controls:AuthLayout>
</ContentPage>
