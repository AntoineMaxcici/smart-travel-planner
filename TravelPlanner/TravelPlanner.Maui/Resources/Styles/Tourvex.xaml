<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<!-- Styles for the trip pages, based on the Tourvex template: rounded white cards on a light
     background, navy headings, teal accents and small uppercase "eyebrow" labels. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <LinearGradientBrush x:Key="TourvexHeroBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0F2454" Offset="0" />
        <GradientStop Color="#1B5A86" Offset="0.55" />
        <GradientStop Color="#2095AE" Offset="1" />
    </LinearGradientBrush>

    <!-- Card media gradients, picked by TripCardViewModel.Palette so neighbouring trips differ. -->
    <LinearGradientBrush x:Key="TripPalette0" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2095AE" Offset="0" />
        <GradientStop Color="#0F2454" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TripPalette1" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#5FD3E6" Offset="0" />
        <GradientStop Color="#2095AE" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TripPalette2" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFB347" Offset="0" />
        <GradientStop Color="#FF6B6B" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TripPalette3" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0F2454" Offset="0" />
        <GradientStop Color="#6C5DD3" Offset="1" />
    </LinearGradientBrush>

    <Style x:Key="TvPage" TargetType="ContentPage">
        <Setter Property="BackgroundColor" Value="{StaticResource TourvexLight}" />
        <Setter Property="Shell.NavBarIsVisible" Value="False" />
    </Style>

    <Style x:Key="TvCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="White" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 24" />
    </Style>

    <Style x:Key="TvSection" TargetType="Border" BasedOn="{StaticResource TvCard}">
        <Setter Property="Padding" Value="20" />
        <Setter Property="StrokeShape" Value="RoundRectangle 20" />
    </Style>

    <Style x:Key="TvPill" TargetType="Border">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="TvInputFrame" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource TourvexLight}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Stroke" Value="#E4E7EE" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="Padding" Value="12,2" />
    </Style>

    <Style x:Key="TvEyebrow" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TourvexTeal}" />
        <Setter Property="FontFamily" Value="BarlowSemiSemibold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CharacterSpacing" Value="2" />
        <Setter Property="TextTransform" Value="Uppercase" />
    </Style>

    <Style x:Key="TvTitle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TourvexNavy}" />
        <Setter Property="FontFamily" Value="BarlowCondensedSemibold" />
        <Setter Property="FontSize" Value="26" />
    </Style>

    <Style x:Key="TvBody" TargetType="Label">
        <Setter Property="FontFamily" Value="BarlowSemiRegular" />
        <Setter Property="TextColor" Value="{StaticResource TourvexBody}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="1.3" />
    </Style>

    <Style x:Key="TvMetaLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="BarlowSemiRegular" />
        <Setter Property="TextColor" Value="{StaticResource TourvexBody}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CharacterSpacing" Value="1" />
        <Setter Property="TextTransform" Value="Uppercase" />
    </Style>

    <Style x:Key="TvMetaValue" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TourvexNavy}" />
        <Setter Property="FontFamily" Value="BarlowSemiSemibold" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="TvError" TargetType="Label">
        <Setter Property="FontFamily" Value="BarlowSemiRegular" />
        <Setter Property="TextColor" Value="{StaticResource TourvexDanger}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="TvPrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource TourvexTeal}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontFamily" Value="BarlowSemiSemibold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="CornerRadius" Value="26" />
        <Setter Property="HeightRequest" Value="52" />
        <Setter Property="Padding" Value="24,0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="#1A7F95" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="0.97" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="#A9D6E0" />
                            <Setter Property="TextColor" Value="White" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="TvGhostButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource TourvexTeal}" />
        <Setter Property="FontFamily" Value="BarlowSemiSemibold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="MinimumHeightRequest" Value="40" />
    </Style>

    <Style x:Key="TvInput" TargetType="Entry">
        <Setter Property="FontFamily" Value="BarlowSemiRegular" />
        <Setter Property="TextColor" Value="{StaticResource TourvexNavy}" />
        <Setter Property="PlaceholderColor" Value="#9AA0B8" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinimumHeightRequest" Value="46" />
    </Style>

    <Style x:Key="TvDatePicker" TargetType="DatePicker">
        <Setter Property="FontFamily" Value="BarlowSemiRegular" />
        <Setter Property="TextColor" Value="{StaticResource TourvexNavy}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Format" Value="ddd d MMM yyyy" />
        <Setter Property="MinimumHeightRequest" Value="46" />
    </Style>

    <Style x:Key="TvPicker" TargetType="Picker">
        <Setter Property="FontFamily" Value="BarlowSemiRegular" />
        <Setter Property="TextColor" Value="{StaticResource TourvexNavy}" />
        <Setter Property="TitleColor" Value="#9AA0B8" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinimumHeightRequest" Value="46" />
    </Style>
    <!-- Auth pages (sign in, sign up, confirm, forgot password): text inside the white form card. -->
    <Style x:Key="TvFormTitle" TargetType="Label">
        <!-- The template's contact-form h3: navy, 35px, with a teal italic word. -->
        <Setter Property="FontFamily" Value="BarlowCondensedMedium" />
        <Setter Property="FontSize" Value="35" />
        <Setter Property="CharacterSpacing" Value="-1" />
        <Setter Property="TextColor" Value="{StaticResource TourvexNavy}" />
        <Setter Property="SemanticProperties.HeadingLevel" Value="Level2" />
    </Style>
    <Style x:Key="TvFormAccent" TargetType="Span">
        <Setter Property="FontFamily" Value="BarlowCondensedItalic" />
        <Setter Property="TextColor" Value="{StaticResource TourvexTeal}" />
    </Style>
    <Style x:Key="TvFormText" TargetType="Label">
        <Setter Property="FontFamily" Value="BarlowSemiRegular" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{StaticResource TourvexBody}" />
    </Style>
    <Style x:Key="TvFieldInput" TargetType="Entry">
        <Setter Property="FontFamily" Value="BarlowSemiRegular" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="TextColor" Value="{StaticResource TourvexNavy}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource TourvexBody}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>
    <Style x:Key="TvHint" TargetType="Label">
        <Setter Property="FontFamily" Value="BarlowSemiRegular" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource TourvexBody}" />
        <Setter Property="Margin" Value="22,-6,0,0" />
    </Style>
    <Style x:Key="TvInfo" TargetType="Label">
        <Setter Property="FontFamily" Value="BarlowSemiRegular" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{StaticResource TourvexTeal}" />
    </Style>
    <Style x:Key="TvLinkButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource TourvexTeal}" />
        <Setter Property="FontFamily" Value="BarlowSemiSemibold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="MinimumHeightRequest" Value="36" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{StaticResource TourvexNavy}" />
                            <Setter Property="BackgroundColor" Value="Transparent" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.5" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
    <!-- Line of faded white text on the navy hero, next to the white arrow button. -->
    <Style x:Key="TvHeroNote" TargetType="Label">
        <Setter Property="FontFamily" Value="BarlowSemiRegular" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="#80FFFFFF" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>
    <!-- Hero heading pieces (the template's header h6 and h2 with its teal lowercase <i>). Write the title span in
         capitals and the accent in lowercase: span TextTransform is not honoured on every platform. -->
    <Style x:Key="TvHeroEyebrow" TargetType="Label">
        <Setter Property="FontFamily" Value="BarlowCondensedMedium" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="CharacterSpacing" Value="6" />
        <Setter Property="TextTransform" Value="Uppercase" />
        <Setter Property="TextColor" Value="{StaticResource TourvexTeal}" />
    </Style>
    <Style x:Key="TvHeroTitle" TargetType="Label">
        <Setter Property="LineHeight" Value="1.0" />
        <Setter Property="SemanticProperties.HeadingLevel" Value="Level1" />
    </Style>
    <Style x:Key="TvHeroTitleSpan" TargetType="Span">
        <Setter Property="FontFamily" Value="BarlowCondensedMedium" />
        <Setter Property="FontSize" Value="50" />
        <Setter Property="CharacterSpacing" Value="-1" />
        <Setter Property="TextColor" Value="White" />
    </Style>
    <Style x:Key="TvHeroAccentSpan" TargetType="Span">
        <Setter Property="FontFamily" Value="BarlowCondensedRegular" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="TextColor" Value="{StaticResource TourvexTeal}" />
    </Style>
    <!-- Tour card bits: the "Duration" pill and the teal price-style value. -->
    <Style x:Key="TvDurationPill" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource TourvexLight}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 20" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="HorizontalOptions" Value="Start" />
    </Style>
    <Style x:Key="TvPrice" TargetType="Label">
        <Setter Property="FontFamily" Value="BarlowCondensedMedium" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="TextColor" Value="{StaticResource TourvexTeal}" />
    </Style>
    <Style x:Key="TvCardTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="BarlowCondensedMedium" />
        <Setter Property="FontSize" Value="27" />
        <Setter Property="TextColor" Value="{StaticResource TourvexNavy}" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>
    <Style x:Key="TvIconPath" TargetType="Path">
        <Setter Property="Stroke" Value="{StaticResource TourvexTeal}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Aspect" Value="Uniform" />
        <Setter Property="WidthRequest" Value="15" />
        <Setter Property="HeightRequest" Value="15" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>
</ResourceDictionary>
