<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TravelPlanner.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    FlyoutBehavior="Disabled"
    Title="TravelPlanner">

    <!-- The page users see after signing in. Its content is set in AppShell.xaml.cs from dependency injection. -->
